<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <androidx.appcompat.widget.Toolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="?attr/actionBarSize" />

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:padding="16dp">

        <EditText
            android:id="@+id/input_account_name"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/hint_account_name"
            android:inputType="textCapWords"
            android:maxLines="1" />

        <TextView
            android:id="@+id/label_account_type"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_below="@id/input_account_name"
            android:layout_marginTop="16dp"
            android:text="@string/label_account_type"
            android:textSize="14sp"
            android:textColor="?android:attr/textColorSecondary" />

        <Spinner
            android:id="@+id/spinner_account_type"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_below="@id/label_account_type"
            android:layout_marginTop="4dp" />

        <TextView
            android:id="@+id/label_instrument"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_below="@id/spinner_account_type"
            android:layout_marginTop="16dp"
            android:text="@string/label_instrument"
            android:textSize="14sp"
            android:textColor="?android:attr/textColorSecondary" />

        <Spinner
            android:id="@+id/spinner_instrument"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_below="@id/label_instrument"
            android:layout_marginTop="4dp" />

        <Button
            android:id="@+id/button_save"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_alignParentBottom="true"
            android:text="@string/action_save" />

    </RelativeLayout>

</LinearLayout>
