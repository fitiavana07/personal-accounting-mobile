<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="4dp"
    android:layout_marginBottom="8dp"
    android:background="@drawable/bg_edge_to_edge_card"
    android:orientation="vertical"
    android:paddingStart="16dp"
    android:paddingTop="10dp"
    android:paddingEnd="16dp"
    android:paddingBottom="12dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/text_p2p_header"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:letterSpacing="0.08"
            android:maxLines="1"
            android:text="@string/home_p2p_header"
            android:textAllCaps="true"
            android:textColor="?android:attr/textColorSecondary"
            android:textSize="12sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/text_p2p_filter"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="?attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="true"
            android:maxLines="1"
            android:paddingStart="8dp"
            android:paddingTop="4dp"
            android:paddingEnd="0dp"
            android:paddingBottom="4dp"
            android:textColor="?attr/colorPrimary"
            android:textSize="12sp" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:orientation="horizontal">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/text_p2p_buy_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/home_p2p_buy_title"
                android:textColor="?android:attr/textColorSecondary"
                android:textSize="12sp" />

            <LinearLayout style="@style/HomeP2pLine">

                <TextView
                    android:id="@+id/text_p2p_buy_1"
                    style="@style/HomeP2pPrice" />

                <TextView
                    android:id="@+id/text_p2p_buy_1_name"
                    style="@style/HomeP2pName" />

                <TextView
                    android:id="@+id/text_p2p_buy_1_limits"
                    style="@style/HomeP2pLimits" />
            </LinearLayout>

            <LinearLayout style="@style/HomeP2pLine">

                <TextView
                    android:id="@+id/text_p2p_buy_2"
                    style="@style/HomeP2pPrice" />

                <TextView
                    android:id="@+id/text_p2p_buy_2_name"
                    style="@style/HomeP2pName" />

                <TextView
                    android:id="@+id/text_p2p_buy_2_limits"
                    style="@style/HomeP2pLimits" />
            </LinearLayout>

            <LinearLayout style="@style/HomeP2pLine">

                <TextView
                    android:id="@+id/text_p2p_buy_3"
                    style="@style/HomeP2pPrice" />

                <TextView
                    android:id="@+id/text_p2p_buy_3_name"
                    style="@style/HomeP2pName" />

                <TextView
                    android:id="@+id/text_p2p_buy_3_limits"
                    style="@style/HomeP2pLimits" />
            </LinearLayout>
        </LinearLayout>

        <View
            android:layout_width="1dp"
            android:layout_height="match_parent"
            android:layout_marginStart="8dp"
            android:layout_marginEnd="8dp"
            android:background="@color/report_divider" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/text_p2p_sell_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/home_p2p_sell_title"
                android:textColor="?android:attr/textColorSecondary"
                android:textSize="12sp" />

            <LinearLayout style="@style/HomeP2pLine">

                <TextView
                    android:id="@+id/text_p2p_sell_1"
                    style="@style/HomeP2pPrice" />

                <TextView
                    android:id="@+id/text_p2p_sell_1_name"
                    style="@style/HomeP2pName" />

                <TextView
                    android:id="@+id/text_p2p_sell_1_limits"
                    style="@style/HomeP2pLimits" />
            </LinearLayout>

            <LinearLayout style="@style/HomeP2pLine">

                <TextView
                    android:id="@+id/text_p2p_sell_2"
                    style="@style/HomeP2pPrice" />

                <TextView
                    android:id="@+id/text_p2p_sell_2_name"
                    style="@style/HomeP2pName" />

                <TextView
                    android:id="@+id/text_p2p_sell_2_limits"
                    style="@style/HomeP2pLimits" />
            </LinearLayout>

            <LinearLayout style="@style/HomeP2pLine">

                <TextView
                    android:id="@+id/text_p2p_sell_3"
                    style="@style/HomeP2pPrice" />

                <TextView
                    android:id="@+id/text_p2p_sell_3_name"
                    style="@style/HomeP2pName" />

                <TextView
                    android:id="@+id/text_p2p_sell_3_limits"
                    style="@style/HomeP2pLimits" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
