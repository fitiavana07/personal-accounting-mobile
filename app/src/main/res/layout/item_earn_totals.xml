<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="8dp"
    android:background="@drawable/bg_metrics_card"
    android:orientation="vertical"
    android:padding="12dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/earn_total_title"
        android:textColor="@color/metrics_card_label"
        android:textSize="14sp" />

    <TextView
        android:id="@+id/text_earn_totals_monthly"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:textColor="@color/metrics_card_value"
        android:textSize="24sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/text_earn_totals_secondary"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:textColor="@color/metrics_card_label"
        android:textSize="13sp" />

</LinearLayout>
