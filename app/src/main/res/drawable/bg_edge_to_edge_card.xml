<?xml version="1.0" encoding="utf-8"?>
<!-- Full-width card: only the top and bottom borders are visible (the side strokes are pushed off-bounds). -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item
        android:left="-2dp"
        android:right="-2dp">
        <shape android:shape="rectangle">
            <solid android:color="@color/section_card_bg" />
            <stroke
                android:width="1dp"
                android:color="@color/report_divider" />
        </shape>
    </item>
</layer-list>
