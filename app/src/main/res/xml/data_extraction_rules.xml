<?xml version="1.0" encoding="utf-8"?><!--
   Backup rules for Android 12 and newer. Everything is transferred except the sync preferences
   (this installation's device id and its sync passphrase, which must never be restored onto another
   phone) and the Cloud Backup preferences (a passphrase sealed with a key that stays on this phone,
   and this installation's folder grant).
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="sync.xml" />
        <exclude domain="sharedpref" path="cloud_backup.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="sync.xml" />
        <exclude domain="sharedpref" path="cloud_backup.xml" />
    </device-transfer>
</data-extraction-rules>
