<?xml version="1.0" encoding="utf-8"?><!--
   Backup rules for Android 12 and newer. Everything is transferred except the sync preferences:
   they hold this installation's device id and its sync passphrase, which must never be restored
   onto another phone.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="sync.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="sync.xml" />
    </device-transfer>
</data-extraction-rules>
