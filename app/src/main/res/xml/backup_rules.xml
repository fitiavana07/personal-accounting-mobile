<?xml version="1.0" encoding="utf-8"?><!--
   Auto Backup rules for Android 11 and older (ignored from API 31, see data_extraction_rules.xml).
   Everything is backed up except the sync preferences: they hold this installation's device id and
   its sync passphrase, which must never be restored onto another phone.
-->
<full-backup-content>
    <exclude domain="sharedpref" path="sync.xml" />
</full-backup-content>
