{
  "attribution": {
    "commit": ""
  },
  "permissions": {
    "allow": [
      "Bash(./gradlew assembleDebug)",
      "Bash(./gradlew assembleDebug testDebugUnitTest)",
      "Bash(./gradlew testDebugUnitTest)"
    ],
    "deny": [
      "Read(./local.properties)",
      "Bash(make)",
      "Bash(make *)",
      "Bash(*scripts/release.sh*)",
      "Bash(*connected*AndroidTest*)",
      "Edit(app/src/androidTest/**)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Read|Grep|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/block-local-properties.sh",
            "statusMessage": "Checking for local.properties access"
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/block-no-verify.sh",
            "statusMessage": "Checking git hook bypass"
          }
        ]
      },
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/guard-build-files.sh",
            "statusMessage": "Checking build file rules"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "file=$(echo \"$CLAUDE_TOOL_INPUT\" | jq -r '.file_path // empty'); [[ \"$file\" == *.kt ]] && ktlint --format \"$file\" || true"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/check-build-and-tests.sh",
            "timeout": 600,
            "statusMessage": "Running build and unit tests"
          }
        ]
      }
    ]
  }
}
